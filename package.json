{
  "name": "cristal-vortex",
  "version": "0.1.0",
  "description": "Acción psicodélica en 3D con gravedad rota (VORTEX) (Three.js + simulación autoritativa)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node server/server.js",
    "test": "node --expose-gc --test --test-concurrency=1 \"tests/*.test.js\"",
    "test:fast": "node --expose-gc --test tests/weapons.test.js tests/physics.test.js tests/ai.test.js tests/waves.test.js tests/limits.test.js",
    "bench": "node tools/perf-browser.js",
    "bots": "node tools/bots-report.js",
    "shots": "node tools/screenshots.js",
    "servidor": "node server/server.js",
    "coop:test": "node --test --test-concurrency=1 tests/coop.test.js tests/coop4.test.js",
    "coop:navegador": "node --test tests/coop-browser.test.js"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "three": "0.186.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "playwright-core": "^1.50.0"
  },
  "engines": {
    "node": ">=20"
  }
}
